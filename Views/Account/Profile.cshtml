@model ECommerceApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Profile";
}

<style>
    .profile-wrapper {
        padding: 0.5rem 0;
    }

        .profile-wrapper h2 {
            font-size: clamp(1.3rem, 5vw, 1.8rem);
            font-weight: 700;
            margin-bottom: 1.25rem;
        }

    .profile-card {
        border-radius: 12px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        overflow: hidden;
    }

        .profile-card .card-body {
            padding: clamp(1rem, 4vw, 1.5rem);
        }

            .profile-card .card-body p {
                font-size: clamp(0.85rem, 3vw, 0.95rem);
                margin-bottom: 0.65rem;
                word-break: break-word;
            }

                .profile-card .card-body p strong {
                    display: inline-block;
                    min-width: 110px;
                    color: #555;
                }

        .profile-card .card-footer {
            padding: clamp(0.75rem, 3vw, 1rem) clamp(1rem, 4vw, 1.5rem);
            background: #f8f9fa;
        }

        .profile-card .btn {
            font-size: clamp(0.82rem, 2.5vw, 0.9rem);
            padding: 0.5rem 1.1rem;
            border-radius: 7px;
            width: 100%;
        }
    @@media (min-width: 400px) {
        .profile-card .btn {
            width: auto;
        }
    }
</style>

<div class="profile-wrapper">
    <h2>My Profile</h2>
    <div class="row">
        <div class="col-12 col-md-6">
            <div class="card profile-card">
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.FirstName @Model.LastName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Member since:</strong> @Model.CreatedAt.ToShortDateString()</p>
                </div>
                <div class="card-footer">
                    <a asp-controller="Order" asp-action="Index" class="btn btn-dark btn-sm">
                        View My Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>