@model ECommerceApp.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .auth-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: clamp(1.5rem, 6vw, 2.5rem);
    }

        .auth-card h2 {
            font-size: clamp(1.4rem, 5vw, 1.8rem);
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        .auth-card .form-control {
            font-size: clamp(0.9rem, 3vw, 1rem);
            padding: 0.6rem 0.85rem;
            border-radius: 8px;
        }

        .auth-card .btn-dark {
            padding: 0.65rem;
            font-size: clamp(0.9rem, 3vw, 1rem);
            border-radius: 8px;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .auth-card .form-label {
            font-size: clamp(0.8rem, 2.5vw, 0.9rem);
            font-weight: 500;
        }

    .auth-footer {
        font-size: clamp(0.8rem, 2.5vw, 0.9rem);
    }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 2.6rem;
        }

    .eye-btn {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: #6c757d;
        line-height: 1;
    }

        .eye-btn:hover {
            color: #212529;
        }
</style>

<div class="auth-wrapper">

    <div class="auth-card">

        <h2>Login</h2>

        @if (TempData["Debug"] != null)
        {
            <div class="alert alert-warning py-2 small">
                @TempData["Debug"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 small">
                @TempData["Success"]
            </div>
        }

        <!-- NORMAL LOGIN FORM -->

        <form asp-action="Login" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 small">
            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email"
                       inputmode="email" />

                <span asp-validation-for="Email"
                      class="text-danger small">
                </span>

            </div>

            <div class="mb-1">

                <label asp-for="Password"
                       class="form-label">
                </label>

                <div class="password-wrapper">

                    <input asp-for="Password"
                           id="loginPassword"
                           class="form-control"
                           autocomplete="current-password" />

                    <button type="button"
                            class="eye-btn"
                            onclick="togglePassword('loginPassword', this)"
                            tabindex="-1">

                        <svg id="eye-open"
                             xmlns="http://www.w3.org/2000/svg"
                             width="18"
                             height="18"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="2">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />

                        </svg>

                    </button>

                </div>

                <span asp-validation-for="Password"
                      class="text-danger small">
                </span>

            </div>

            <div class="mb-3 text-end">

                <a asp-action="ForgotPassword"
                   class="small text-muted">

                    Forgot password?

                </a>

            </div>

            <div class="mb-4 form-check">

                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe"
                       class="form-check-label small">
                </label>

            </div>

            <button type="submit"
                    class="btn btn-dark w-100">

                Login

            </button>

        </form>

        <!-- GOOGLE LOGIN -->

        <div class="mt-3">

            <form asp-action="ExternalLogin" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="provider"
                       value="Google" />

                <input type="hidden"
                       name="returnUrl"
                       value="@ViewBag.ReturnUrl" />

                <button type="submit"
                        class="btn btn-outline-dark w-100">

                    <img src="https://developers.google.com/identity/images/g-logo.png"
                         width="18"
                         class="me-2" />

                    Continue with Google

                </button>

            </form>

        </div>

        <p class="mt-3 text-center auth-footer mb-0">

            No account?

            <a asp-action="Register"
               asp-route-returnUrl="@ViewBag.ReturnUrl">

                Register here

            </a>

        </p>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScripts" />

    <script>

        function togglePassword(inputId, btn) {

            const input = document.getElementById(inputId);

            input.type =
                input.type === 'password'
                ? 'text'
                : 'password';

            btn.style.color =
                input.type === 'text'
                ? '#212529'
                : '#6c757d';
        }

    </script>

}