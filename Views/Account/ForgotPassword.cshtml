@{
    ViewData["Title"] = "Forgot Password";
}
<style>
    .auth-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: clamp(1.5rem, 6vw, 2.5rem);
    }
    .auth-card h2 {
        font-size: clamp(1.4rem, 5vw, 1.8rem);
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .auth-card .form-control {
        font-size: clamp(0.9rem, 3vw, 1rem);
        padding: 0.6rem 0.85rem;
        border-radius: 8px;
    }
    .auth-card .btn-dark {
        padding: 0.65rem;
        font-size: clamp(0.9rem, 3vw, 1rem);
        border-radius: 8px;
        font-weight: 600;
    }
    .auth-card .form-label {
        font-size: clamp(0.8rem, 2.5vw, 0.9rem);
        font-weight: 500;
    }
    .auth-footer { font-size: clamp(0.8rem, 2.5vw, 0.9rem); }
</style>
<div class="auth-wrapper">
    <div class="auth-card">
        <h2>Forgot Password</h2>
        <p class="text-muted small mb-4">Enter your email and we'll send you a reset link.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 small">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Email address</label>
                <input type="email" name="email" class="form-control" autocomplete="email"
                       inputmode="email" required placeholder="you@example.com" />
            </div>
            <button type="submit" class="btn btn-dark w-100">Send Reset Link</button>
        </form>
        <p class="mt-3 text-center auth-footer mb-0">
            <a asp-action="Login">← Back to Login</a>
        </p>
    </div>
</div>