@{
    ViewData["Title"] = "Privacy Policy – Afaq Mart";
}

<style>
    .policy-wrap { max-width: 760px; margin: 3rem auto; padding: 0 1rem 3rem; }
    .policy-wrap h1 { font-size: 1.8rem; font-weight: 800; color: var(--am-ink); margin-bottom: .4rem; }
    .policy-updated { font-size: .8rem; color: var(--am-muted); margin-bottom: 2rem; }
    .policy-wrap h2 { font-size: 1.1rem; font-weight: 700; color: var(--am-ink); margin: 2rem 0 .6rem; }
    .policy-wrap p, .policy-wrap li { color: #475569; line-height: 1.8; font-size: .93rem; margin-bottom: .75rem; }
    .policy-wrap ul { padding-left: 1.4rem; }
    .policy-wrap hr { border: none; border-top: 1px solid var(--am-border); margin: 2rem 0; }
</style>

<div class="policy-wrap">
    <h1>Privacy Policy</h1>
    <p class="policy-updated">Last updated: May 2026</p>

    <p>
        Afaq Mart ("we", "our", "us") is committed to protecting your personal information.
        This Privacy Policy explains what data we collect, how we use it, and your rights.
    </p>

    <hr />

    <h2>1. Information We Collect</h2>
    <ul>
        <li><strong>Account information</strong> — name, email address, password (hashed).</li>
        <li><strong>Order information</strong> — shipping address, phone number, purchase history.</li>
        <li><strong>Payment information</strong> — card details are processed by our payment provider and never stored on our servers.</li>
        <li><strong>Usage data</strong> — pages visited, browser type, IP address, and device information collected automatically.</li>
    </ul>

    <h2>2. How We Use Your Information</h2>
    <ul>
        <li>Process and deliver your orders.</li>
        <li>Send order confirmations and delivery updates.</li>
        <li>Respond to customer support requests.</li>
        <li>Improve our website and personalise your experience.</li>
        <li>Send promotional emails (you can unsubscribe at any time).</li>
    </ul>

    <h2>3. Sharing Your Information</h2>
    <p>
        We do not sell your personal data. We share it only with trusted service providers
        (courier companies, payment processors) strictly necessary to fulfil your order,
        and with legal authorities if required by law.
    </p>

    <h2>4. Cookies</h2>
    <p>
        We use cookies to keep you logged in, remember your cart, and analyse site traffic.
        See our <a asp-controller="Home" asp-action="Cookie" style="color:var(--am-accent);">Cookie Policy</a> for details.
    </p>

    <h2>5. Data Retention</h2>
    <p>
        We retain your account data for as long as your account is active or as needed
        to provide services. You may request deletion at any time by contacting us.
    </p>

    <h2>6. Your Rights</h2>
    <ul>
        <li>Access the personal data we hold about you.</li>
        <li>Request correction or deletion of your data.</li>
        <li>Opt out of marketing communications.</li>
    </ul>

    <h2>7. Contact</h2>
    <p>
        For privacy-related questions, visit our <a asp-controller="Home" asp-action="Contact" style="color:var(--am-accent);">Contact page</a>.
    </p>
</div>
