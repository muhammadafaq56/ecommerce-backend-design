    @* ── 4. FEATURED PRODUCTS ─────────────────────────────────── *@
    @if (featured != null && featured.Any())
    {
        <section class="am-section" aria-labelledby="featured-heading">
            <div class="am-section-header">
                <h2 class="am-section-title" id="featured-heading">
                    Featured Products
                    <span class="badge bg-success">Top Picks</span>
                </h2>
                <a asp-controller="Shop" asp-action="Index" class="am-see-all">
                    View All <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="am-prod-grid">
                @foreach (var p in featured.Take(8))
                {
                    var detailUrl = Url.Action("Detail", "Shop", new { id = p.Id });
                    var totalReviews = p.Reviews?.Count ?? 0;
                    var computedRating = totalReviews > 0 ? p.Reviews.Average(r => r.Rating) : p.Rating;

                    <article class="am-prod-card" itemscope itemtype="https://schema.org/Product">
                        @if (p.OriginalPrice.HasValue)
                        {
                            <span class="am-prod-badge am-prod-badge--sale">Sale</span>
                        }
                        <div class="am-prod-img">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl"
                                     alt="@p.Name – @p.Brand"
                                     loading="lazy" width="300" height="300"
                                     itemprop="image" />
                            }
                            else
                            {
                                <span class="am-prod-img-placeholder" aria-hidden="true">📦</span>
                            }
                        </div>
                        <div class="am-prod-body">
                            <p class="am-prod-brand" itemprop="brand">@p.Brand</p>
                            <h3 class="am-prod-name" itemprop="name">
                                <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.Id"
                                   style="text-decoration:none;color:inherit;">@p.Name</a>
                            </h3>
                            <div class="am-prod-rating" aria-label="Rated @computedRating.ToString("0.0") out of 5 — @totalReviews reviews">
                                <span class="am-stars-wrap" aria-hidden="true">
                                    @RenderStars(computedRating)
                                </span>
                                <span class="am-prod-reviews">(@totalReviews)</span>
                            </div>
                            <div class="am-prod-prices" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                <meta itemprop="priceCurrency" content="USD" />
                                <meta itemprop="price" content="@p.Price" />
                                <meta itemprop="availability" content="@(p.StockQuantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")" />
                                <meta itemprop="url" content="https://afaqmart.com/Shop/Detail/@p.Id" />
                                <span class="am-prod-price">$ @p.Price.ToString("F2")</span>
                                @if (p.OriginalPrice.HasValue)
                                {
                                    <span class="am-prod-orig">$ @p.OriginalPrice.Value.ToString("F2")</span>
                                    <span class="am-prod-disc">-@p.DiscountPercentage%</span>
                                }
                            </div>
                        </div>
                        <div class="am-prod-footer">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.Id"
                               class="btn btn-outline-dark btn-sm">Details</a>
                            @if (p.StockQuantity > 0)
                            {
                                <button class="btn btn-dark btn-sm btn-add-cart"
                                        data-product-id="@p.Id"
                                        aria-label="Add @p.Name to cart">
                                    <i class="bi bi-cart-plus" aria-hidden="true"></i> Add
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled>Out of Stock</button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

