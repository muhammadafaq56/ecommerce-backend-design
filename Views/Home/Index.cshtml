@* ── Toast container ──────────────────────────────────────────── *@
<div id="cart-toast-container" aria-live="polite" aria-atomic="true"></div>

@* ══════════════════════════════════════════════════════════════
   RAZOR HELPER — Renders star icons from a double rating (0–5)
   Uses half-star logic: e.g. 4.3 → 4 full + 1 half + 0 empty
   ══════════════════════════════════════════════════════════════ *@
@functions {
    Microsoft.AspNetCore.Html.IHtmlContent RenderStars(double rating)
    {
        var sb = new System.Text.StringBuilder();
        int full = (int)Math.Floor(rating);
        bool half = (rating - full) >= 0.25 && (rating - full) < 0.75;

        if ((rating - full) >= 0.75)
        {
            full++;
            half = false;
        }

        int empty = 5 - full - (half ? 1 : 0);

        for (int i = 0; i < full; i++)
            sb.Append("<span class='am-star-full'>★</span>");

        if (half)
            sb.Append("<span class='am-star-half'>½</span>");

        for (int i = 0; i < empty; i++)
            sb.Append("<span class='am-star-empty'>☆</span>");

        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

@section Scripts {
    <script>
        // ── Add to Cart ────────────────────────────────────────────────
        function attachAddToCart() {
            document.querySelectorAll('.btn-add-cart').forEach(function (btn) {
                if (btn.dataset.bound) return;
                btn.dataset.bound = 'true';

                btn.addEventListener('click', async function () {
                    const productId    = this.dataset.productId;
                    const originalHTML = this.innerHTML;
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        const res   = await fetch('/Cart/Add', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                ...(token ? { 'RequestVerificationToken': token } : {})
                            },
                            body: `productId=${encodeURIComponent(productId)}&quantity=1`
                        });

                        if (!res.ok) throw new Error('Network error');
                        const data = await res.json();

                        if (data.success) {
                            if (window.setCartBadge) window.setCartBadge(data.count || 0);
                            showToast('✓ Added to cart successfully!', 'success');
                            this.innerHTML = '<i class="bi bi-check-lg" aria-hidden="true"></i> Added';
                            setTimeout(() => { this.innerHTML = originalHTML; this.disabled = false; }, 2000);
                        } else {
                            showToast(data.message || 'Could not add item to cart.', 'danger');
                            this.innerHTML = originalHTML;
                            this.disabled  = false;
                        }
                    } catch {
                        showToast('Something went wrong. Please try again.', 'danger');
                        this.innerHTML = originalHTML;
                        this.disabled  = false;
                    }
                });
            });
        }

        // ── Toast notifications ────────────────────────────────────────
        function showToast(message, type) {
            const container = document.getElementById('cart-toast-container');
            const icon      = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
            const toast     = document.createElement('div');

            toast.className  = `alert alert-${type} shadow-sm py-2 px-3 mb-0 d-flex align-items-center gap-2`;
            toast.style.cssText = 'min-width:260px;font-size:.9rem;border-radius:12px;border:none;animation:_toastIn .3s ease;';
            toast.innerHTML  = `<i class="bi ${icon}" aria-hidden="true"></i><span>${message}</span>`;

            if (!document.getElementById('_toast-style')) {
                const s = document.createElement('style');
                s.id = '_toast-style';
                s.textContent = '@@keyframes _toastIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}';
                document.head.appendChild(s);
            }

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.cssText += 'opacity:0;transition:opacity .3s;';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // ── Init ───────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', attachAddToCart);
    </script>
}