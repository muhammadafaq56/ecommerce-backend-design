@{
    ViewData["Title"] = "Terms of Service – Afaq Mart";
}

<style>
    .policy-wrap { max-width: 760px; margin: 3rem auto; padding: 0 1rem 3rem; }
    .policy-wrap h1 { font-size: 1.8rem; font-weight: 800; color: var(--am-ink); margin-bottom: .4rem; }
    .policy-updated { font-size: .8rem; color: var(--am-muted); margin-bottom: 2rem; }
    .policy-wrap h2 { font-size: 1.1rem; font-weight: 700; color: var(--am-ink); margin: 2rem 0 .6rem; }
    .policy-wrap p, .policy-wrap li { color: #475569; line-height: 1.8; font-size: .93rem; margin-bottom: .75rem; }
    .policy-wrap ul { padding-left: 1.4rem; }
    .policy-wrap hr { border: none; border-top: 1px solid var(--am-border); margin: 2rem 0; }
</style>

<div class="policy-wrap">
    <h1>Terms of Service</h1>
    <p class="policy-updated">Last updated: May 2026</p>

    <p>
        By accessing or using the Afaq Mart website, you agree to be bound by these Terms of Service.
        Please read them carefully before placing an order.
    </p>

    <hr />

    <h2>1. Use of the Website</h2>
    <p>
        You must be at least 18 years old to create an account and make purchases.
        You agree to provide accurate, current, and complete information during registration and checkout.
        You are responsible for maintaining the confidentiality of your account credentials.
    </p>

    <h2>2. Orders and Pricing</h2>
    <ul>
        <li>All prices are displayed in USD and are subject to change without notice.</li>
        <li>An order confirmation email does not constitute acceptance; we reserve the right to cancel orders due to stock issues or pricing errors.</li>
        <li>We reserve the right to limit order quantities.</li>
    </ul>

    <h2>3. Payment</h2>
    <p>
        We accept major credit/debit cards and cash on delivery (COD). Payment must be completed
        before your order is dispatched (except COD orders). We use industry-standard encryption
        to protect your payment information.
    </p>

    <h2>4. Shipping and Delivery</h2>
    <p>
        Delivery timelines are estimates and not guaranteed. Afaq Mart is not liable for delays
        caused by courier services, weather, or other factors beyond our control.
    </p>

    <h2>5. Returns and Refunds</h2>
    <p>
        You may return eligible items within 7 days of delivery. Items must be unused and in
        original packaging. Refunds are processed within 5–7 business days of receiving the return.
        See our full return policy for details.
    </p>

    <h2>6. Prohibited Activities</h2>
    <ul>
        <li>Using the site for any unlawful purpose.</li>
        <li>Attempting to gain unauthorised access to our systems.</li>
        <li>Submitting false or fraudulent orders.</li>
        <li>Reselling products purchased at promotional prices without authorisation.</li>
    </ul>

    <h2>7. Limitation of Liability</h2>
    <p>
        Afaq Mart is not liable for any indirect, incidental, or consequential damages arising
        from your use of the website or products purchased. Our maximum liability is limited
        to the amount paid for the order in question.
    </p>

    <h2>8. Changes to Terms</h2>
    <p>
        We may update these Terms at any time. Continued use of the website after changes
        constitutes your acceptance of the updated Terms.
    </p>

    <h2>9. Contact</h2>
    <p>
        Questions about these Terms? Visit our
        <a asp-controller="Home" asp-action="Contact" style="color:var(--am-accent);">Contact page</a>
    </p>
</div>
