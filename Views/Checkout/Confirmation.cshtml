@model ECommerceApp.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<style>
    .confirm-wrapper {
        padding: clamp(1.5rem, 5vw, 3rem) 0;
    }

    /* Hero success block */
    .confirm-hero {
        text-align: center;
        margin-bottom: clamp(1.5rem, 5vw, 3rem);
        padding: 0 1rem;
    }
    .confirm-hero .check-icon {
        font-size: clamp(3rem, 12vw, 5rem);
        color: #198754;
        display: block;
        margin-bottom: 0.5rem;
    }
    .confirm-hero h1 {
        font-size: clamp(1.5rem, 6vw, 2.2rem);
        font-weight: 800;
        color: #198754;
        margin-bottom: 0.5rem;
    }
    .confirm-hero .lead {
        font-size: clamp(0.9rem, 3vw, 1.1rem);
        margin-bottom: 0.25rem;
    }
    .confirm-hero p {
        font-size: clamp(0.82rem, 2.5vw, 0.95rem);
        margin-bottom: 0.3rem;
    }

    /* Cards */
    .confirm-card {
        border-radius: 12px;
        border: 0;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }
    .confirm-card .card-header {
        padding: 0.75rem 1.1rem;
    }
    .confirm-card .card-header h5 {
        font-size: clamp(0.9rem, 3vw, 1rem);
        margin: 0;
    }
    .confirm-card .card-body {
        padding: clamp(0.85rem, 3vw, 1.25rem);
        font-size: clamp(0.82rem, 2.5vw, 0.92rem);
    }

    /* Order items */
    .order-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
    }
    .order-item-name {
        font-weight: 600;
        font-size: clamp(0.82rem, 2.5vw, 0.92rem);
        margin-bottom: 0.1rem;
    }
    .order-item-qty {
        font-size: clamp(0.75rem, 2vw, 0.82rem);
        color: #6c757d;
    }
    .order-item-price {
        font-weight: 700;
        white-space: nowrap;
        font-size: clamp(0.85rem, 2.5vw, 0.95rem);
    }

    /* Summary rows */
    .price-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.4rem;
        font-size: clamp(0.82rem, 2.5vw, 0.92rem);
    }
    .price-row.total {
        font-size: clamp(1rem, 3.5vw, 1.15rem);
        font-weight: 700;
    }

    /* Shipping info */
    .info-row {
        font-size: clamp(0.82rem, 2.5vw, 0.92rem);
        margin-bottom: 0.4rem;
        word-break: break-word;
    }
    .info-row strong {
        display: inline-block;
        min-width: 60px;
        color: #555;
    }

    /* Action buttons */
    .confirm-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: clamp(1.5rem, 5vw, 2.5rem);
        padding: 0 1rem;
    }
    .confirm-actions .btn {
        flex: 1 1 auto;
        max-width: 220px;
        min-width: 140px;
        font-size: clamp(0.85rem, 3vw, 0.95rem);
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-weight: 600;
    }
</style>

<div class="container confirm-wrapper">

    <!-- Success Hero -->
    <div class="confirm-hero">
        <i class="bi bi-check-circle-fill check-icon"></i>
        <h1>Order Confirmed!</h1>
        <p class="lead mb-1">Thank you, <strong>@Model.CustomerName</strong></p>
        <p class="text-muted">Your order has been placed successfully.</p>
        <p>Order Number: <strong class="text-dark">@Model.OrderNumber</strong></p>
        <p class="text-muted">Confirmation sent to <strong>@Model.CustomerEmail</strong></p>
    </div>

    <!-- Details -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">

            <!-- Order Items + Pricing -->
            <div class="card confirm-card">
                <div class="card-header bg-dark text-white">
                    <h5>Order Details</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.Items)
                    {
                        <div class="order-item">
                            <div>
                                <div class="order-item-name">@item.ProductName</div>
                                <div class="order-item-qty">Qty: @item.Quantity</div>
                            </div>
                            <div class="order-item-price">$@(item.UnitPrice * item.Quantity)</div>
                        </div>
                    }
                    <hr class="my-2" />
                    <div class="price-row"><span>Subtotal</span><span>$@Model.SubTotal</span></div>
                    <div class="price-row">
                        <span>Shipping</span>
                        <span>@(Model.ShippingCost == 0 ? "Free" : "$" + Model.ShippingCost)</span>
                    </div>
                    <div class="price-row"><span>Tax</span><span>$@Model.Tax</span></div>
                    <hr class="my-2" />
                    <div class="price-row total">
                        <span>Total</span>
                        <span class="text-success">$@Model.Total</span>
                    </div>
                </div>
            </div>

            <!-- Shipping Info -->
            <div class="card confirm-card">
                <div class="card-header bg-light">
                    <h5>Shipping Information</h5>
                </div>
                <div class="card-body">
                    <p class="info-row"><strong>Name:</strong> @Model.CustomerName</p>
                    <p class="info-row"><strong>Email:</strong> @Model.CustomerEmail</p>
                    <p class="info-row mb-0"><strong>Address:</strong> @Model.ShippingAddress</p>
                </div>
            </div>

        </div>
    </div>

    <!-- Actions -->
    <div class="confirm-actions">
        <a asp-controller="Shop" asp-action="Index" class="btn btn-dark">
            Continue Shopping
        </a>
        @if (User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-dark">
                View My Orders
            </a>
        }
    </div>

</div>