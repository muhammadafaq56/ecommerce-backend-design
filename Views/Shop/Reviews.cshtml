@model ECommerceApp.Models.Product
@using ECommerceApp.Models
@{
    var totalReviews = Model.Reviews?.Count ?? 0;
    var averageRating = totalReviews > 0 ? Model.Reviews.Average(r => r.Rating) : 0.0;
    ViewData["Title"] = $"{Model.Name} – Reviews";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<style>
    .am-reviews-container {
        max-width: 760px;
        margin: 0 auto 3.5rem auto;
    }

    .am-reviews-back-btn {
        font-size: 0.82rem;
        color: var(--am-muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 1.5rem;
        transition: color 0.15s;
    }

        .am-reviews-back-btn:hover {
            color: var(--am-ink);
        }

    .am-reviews-summary-card {
        background: var(--am-surface);
        border: 1px solid var(--am-border);
        border-radius: var(--am-radius-lg);
        padding: 2rem;
        text-align: center;
        margin-bottom: 2.5rem;
        box-shadow: 0 1px 6px rgba(0,0,0,0.02);
    }

    .am-summary-title {
        font-family: var(--font-display);
        font-size: clamp(1.3rem, 4vw, 1.6rem);
        font-weight: 800;
        color: var(--am-ink);
        margin-bottom: 0.25rem;
    }

    .am-summary-subtitle {
        font-size: 0.85rem;
        color: var(--am-muted);
        margin-bottom: 1.25rem;
    }

    .am-big-score-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .am-big-score {
        font-size: clamp(2.5rem, 8vw, 3.5rem);
        font-weight: 800;
        color: var(--am-ink);
        line-height: 1;
    }

    .am-summary-stars {
        color: #ffc107;
        font-size: 1.15rem;
        letter-spacing: 2px;
        margin-bottom: 0.2rem;
    }

        .am-summary-stars .empty-star {
            color: #e4e5e9;
        }

    .am-total-count-lbl {
        font-size: 0.78rem;
        color: var(--am-muted);
        display: block;
    }

    .am-reviews-header-title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--am-ink);
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--am-border);
        padding-bottom: 0.5rem;
    }

    .am-review-feed {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .am-review-item {
        background: var(--am-surface);
        border: 1px solid var(--am-border);
        border-radius: var(--am-radius-lg);
        padding: 1.25rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.01);
    }

    .am-review-meta {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.6rem;
    }

    .am-reviewer-name {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--am-ink);
        display: block;
        line-height: 1.3;
    }

    .am-review-date {
        font-size: 0.75rem;
        color: var(--am-muted);
    }

    .am-item-stars {
        color: #ffc107;
        font-size: 0.8rem;
        letter-spacing: 1px;
        background: var(--am-page);
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid var(--am-border);
    }

        .am-item-stars .empty-star {
            color: #e4e5e9;
        }

    .am-review-text {
        font-size: 0.88rem;
        color: #444;
        line-height: 1.5;
        margin-bottom: 0;
        white-space: pre-line;
    }
</style>

<div class="am-reviews-container">
    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@Model.Id" class="am-reviews-back-btn">
        <i class="bi bi-arrow-left"></i> Back to @Model.Name
    </a>

    <div class="am-reviews-summary-card">
        <h2 class="am-summary-title">Customer Reviews</h2>
        <p class="am-summary-subtitle">User feedback metrics overview for @Model.Name</p>

        <div class="am-big-score-row">
            <div class="am-big-score">@averageRating.ToString("0.0")</div>
            <div class="text-start">
                <div class="am-summary-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(averageRating))
                        {
                            <span>★</span>
                        }
                        else
                        {

                            <span class="empty-star">★</span>
                        }
                    }
                </div>
                <span class="am-total-count-lbl">Based on @totalReviews verified ratings</span>
            </div>
        </div>
    </div>

    <h3 class="am-reviews-header-title">All Customer Reviews (@totalReviews)</h3>

    @if (Model.Reviews == null || !Model.Reviews.Any())
    {
        <div class="alert bg-light border text-center py-4" style="border-radius: var(--am-radius-lg);">
            <i class="bi bi-chat-left-dots text-muted fs-3 d-block mb-2"></i>
            <span class="text-muted small">No reviews written for this product yet.</span>
        </div>
    }
    else
    {
        <div class="am-review-feed">
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
            {
                <div class="am-review-item">
                    <div class="am-review-meta">
                        <div>
                            <strong class="am-reviewer-name">@review.CustomerName</strong>
                            <span class="am-review-date">📅 @review.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="am-item-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <span>★</span>
                                }
                                else
                                {

                                    <span class="empty-star">★</span>
                                }
                            }
                        </div>
                    </div>
                    <p class="am-review-text">@review.ReviewText</p>
                </div>
            }
        </div>
    }
</div>