@model ECommerceApp.Models.ViewModels.ShopViewModel
@{
    ViewData["Title"] = Model.CategoryId != null ? (Model.Categories.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name ?? "Shop") : "Shop";
    ViewData["MetaDescription"] = "Browse " + Model.TotalItems + " products at Afaq Mart. Filter by category, sort by price or rating. Fast delivery across Pakistan.";
}

<style>
    /* ════════════════════════════════════════════
               SHOP PAGE — MOBILE-FIRST RESPONSIVE STYLES
               ════════════════════════════════════════════ */

    /* ── SHOP LAYOUT ── */
    .am-shop-layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 1.75rem;
        align-items: start;
        /* Prevent any child from blowing out the layout */
        min-width: 0;
    }

    /* Tablet: narrower sidebar */
    @@media (max-width: 991px) and (min-width: 768px) {
        .am-shop-layout {
            grid-template-columns: 180px 1fr;
            gap: 1.25rem;
        }
    }

    /* Mobile: single column */
    @@media (max-width: 767px) {
        .am-shop-layout {
            grid-template-columns: 1fr;
            gap: 0.85rem;
        }
    }

    /* ── SIDEBAR ── */
    .am-sidebar {
        background: var(--am-surface);
        border: 1px solid var(--am-border);
        border-radius: var(--am-radius-lg);
        padding: 1.25rem;
        position: sticky;
        top: 80px;
        /* Prevent sidebar from overflowing its grid cell */
        min-width: 0;
        overflow: hidden;
    }

    .am-sidebar-heading {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--am-muted);
        margin-bottom: 0.85rem;
    }

    .am-cat-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .am-cat-list li a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.75rem;
            border-radius: var(--am-radius);
            font-size: 0.875rem;
            color: var(--am-muted);
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
            min-height: 44px;
        }

            .am-cat-list li a:hover,
            .am-cat-list li a:focus-visible {
                background: var(--am-page);
                color: var(--am-ink);
                outline: 2px solid var(--am-accent);
                outline-offset: -2px;
            }

        .am-cat-list li.active a {
            background: var(--am-ink);
            color: #fff;
            font-weight: 600;
        }

            .am-cat-list li.active a .am-cat-pill {
                background: rgba(255,255,255,0.2);
                color: #fff;
            }

    .am-cat-pill {
        background: var(--am-page);
        color: var(--am-muted);
        font-size: 0.7rem;
        padding: 2px 7px;
        border-radius: 10px;
        flex-shrink: 0;
    }

    /* ── MOBILE CATEGORY STRIP ── */
    @@media (max-width: 767px) {
        .am-sidebar {
            padding: 0.6rem 0.75rem;
            border-radius: var(--am-radius);
            position: static;
            /* Allow horizontal scroll without affecting page width */
            overflow: hidden;
        }

        .am-sidebar-heading {
            display: none;
        }

        .am-cat-list {
            flex-direction: row;
            overflow-x: auto;
            flex-wrap: nowrap;
            gap: 6px;
            padding-bottom: 4px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            scroll-snap-type: x mandatory;
            /* Prevent the strip from causing page-level horizontal scroll */
            max-width: 100%;
        }

            .am-cat-list::-webkit-scrollbar {
                display: none;
            }

            .am-cat-list li {
                flex-shrink: 0;
                scroll-snap-align: start;
            }

                .am-cat-list li a {
                    white-space: nowrap;
                    border-radius: 20px;
                    padding: 0.35rem 0.9rem;
                    font-size: 0.82rem;
                    border: 1px solid var(--am-border);
                    min-height: 44px;
                }

                .am-cat-list li.active a {
                    border-color: var(--am-ink);
                }

        .am-cat-pill {
            display: none;
        }
    }

    /* ── SEARCH & SORT BAR ── */
    .am-search-bar {
        background: var(--am-surface);
        border: 1px solid var(--am-border);
        border-radius: var(--am-radius-lg);
        padding: 0.85rem 1rem;
        display: flex;
        gap: 0.6rem;
        align-items: center;
        margin-bottom: 1.25rem;
        /* Use a 2-row layout so sort always stays on its own row on small screens */
        flex-wrap: wrap;
        width: 100%;
        box-sizing: border-box;
    }

        .am-search-bar .form-control,
        .am-search-bar .form-select {
            border: 1px solid var(--am-border);
            border-radius: var(--am-radius);
            font-family: var(--font-body);
            font-size: 0.875rem;
            background: var(--am-page);
            color: var(--am-ink);
            padding: 0.5rem 0.8rem;
            min-height: 44px;
            box-sizing: border-box;
        }

            .am-search-bar .form-control:focus,
            .am-search-bar .form-select:focus {
                border-color: var(--am-accent);
                box-shadow: 0 0 0 3px rgba(184,130,10,0.12);
                outline: none;
            }

    .am-search-input {
        flex: 1 1 160px;
        min-width: 0;
    }

    .am-sort-select {
        flex: 0 0 145px;
    }

    .am-search-btn {
        background: var(--am-ink);
        color: #fff;
        border: none;
        border-radius: var(--am-radius);
        padding: 0.5rem 0.85rem;
        font-size: 0.875rem;
        cursor: pointer;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: opacity 0.15s;
        min-height: 44px;
        min-width: 44px;
        box-sizing: border-box;
    }

        .am-search-btn:hover {
            opacity: 0.85;
        }

        .am-search-btn:focus-visible {
            outline: 2px solid var(--am-accent);
            outline-offset: 2px;
        }

    /* Mobile search bar */
    @@media (max-width: 575px) {
        .am-search-bar {
            padding: 0.65rem 0.75rem;
            gap: 0.5rem;
            border-radius: var(--am-radius);
            margin-bottom: 0.85rem;
        }
        /* Row 1: search input + search button */
        .am-search-input {
            flex: 1 1 0;
            min-width: 0;
            order: 1;
        }

        .am-search-btn {
            order: 2;
            flex-shrink: 0;
        }
        /* Row 2: sort select full width */
        .am-sort-select {
            order: 3;
            flex: 1 1 100%;
            width: 100%;
        }
    }

    /* ── RESULTS META ── */
    .am-results-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.1rem;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .am-results-count {
        font-size: 0.85rem;
        color: var(--am-muted);
    }

        .am-results-count strong {
            color: var(--am-ink);
        }

    @@media (max-width: 400px) {
        .am-results-count {
            font-size: 0.78rem;
        }
    }

    /* ── PRODUCT GRID ── */
    .am-prod-grid {
        display: grid;
        /* Use minmax(0, 1fr) to prevent grid blowout */
        grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
        gap: 14px;
    }

    /* Tablet */
    @@media (max-width: 991px) and (min-width: 576px) {
        .am-prod-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }
    }

    /* Mobile — strict 2 columns, no overflow */
    @@media (max-width: 575px) {
        .am-prod-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }
    }

    @@media (max-width: 359px) {
        .am-prod-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 7px;
        }
    }

    /* ── PRODUCT CARD ── */
    .am-prod-card {
        background: var(--am-surface);
        border: 1px solid var(--am-border);
        border-radius: var(--am-radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.22s, transform 0.22s;
        position: relative;
        /* Prevent card content from blowing out grid column */
        min-width: 0;
    }

        .am-prod-card:hover {
            box-shadow: var(--am-shadow-lg);
            transform: translateY(-3px);
        }

    @@media (hover: none) {
        .am-prod-card:hover {
            box-shadow: none;
            transform: none;
        }

        .am-prod-card:active {
            transform: scale(0.98);
            transition: transform 0.08s;
        }
    }

    @@media (max-width: 575px) {
        .am-prod-card {
            border-radius: var(--am-radius);
        }
    }

    /* ── BADGES ── */
    .am-prod-badge-sale {
        position: absolute;
        top: 9px;
        left: 9px;
        z-index: 2;
        background: var(--am-red);
        color: #fff;
        font-size: 0.67rem;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 5px;
    }

    .am-prod-badge-cat {
        position: absolute;
        top: 9px;
        right: 9px;
        z-index: 2;
        background: rgba(0,0,0,0.45);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 500;
        padding: 2px 7px;
        border-radius: 5px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        max-width: 50%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 575px) {
        .am-prod-badge-cat {
            display: none;
        }

        .am-prod-badge-sale {
            top: 6px;
            left: 6px;
            font-size: 0.6rem;
            padding: 1px 5px;
        }
    }

    /* ── PRODUCT IMAGE ── */
    .am-prod-img {
        width: 100%;
        height: clamp(110px, 24vw, 175px);
        background: var(--am-page);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-bottom: 1px solid var(--am-border);
    }

        .am-prod-img img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 8px;
            /* Prevent img from overflowing on very narrow cards */
            max-width: 100%;
            box-sizing: border-box;
        }

    @@media (max-width: 575px) {
        .am-prod-img {
            /* Use vw-based height so it scales with 2-col grid correctly */
            height: clamp(90px, 28vw, 140px);
        }

            .am-prod-img img {
                padding: 5px;
            }
    }

    .am-prod-img-placeholder {
        font-size: clamp(2rem, 6vw, 3rem);
        color: #c8c4ba;
    }

    /* ── PRODUCT BODY ── */
    .am-prod-body {
        padding: 0.8rem 0.85rem 0.4rem;
        flex: 1;
        /* Prevent long words from blowing out card width */
        overflow: hidden;
        min-width: 0;
    }

    @@media (max-width: 575px) {
        .am-prod-body {
            padding: 0.55rem 0.6rem 0.3rem;
        }
    }

    .am-prod-brand {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--am-muted);
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 575px) {
        .am-prod-brand {
            font-size: 0.62rem;
        }
    }

    .am-prod-name {
        font-size: clamp(0.75rem, 2.2vw, 0.88rem);
        font-weight: 600;
        color: var(--am-ink);
        margin-bottom: 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
        word-break: break-word;
    }

    /* ── RATING ── */
    .am-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 6px;
    }

    .am-stars {
        color: var(--am-accent);
        font-size: clamp(0.65rem, 2vw, 0.72rem);
        letter-spacing: 1px;
    }

    .am-rating-count {
        font-size: 0.68rem;
        color: var(--am-muted);
    }

    @@media (max-width: 400px) {
        .am-rating-count {
            display: none;
        }
    }

    /* ── PRICES ── */
    .am-prod-prices {
        display: flex;
        align-items: baseline;
        gap: 5px;
        flex-wrap: wrap;
    }

    .am-prod-price {
        font-size: clamp(0.85rem, 2.5vw, 0.95rem);
        font-weight: 700;
        color: var(--am-green);
    }

    .am-prod-orig {
        font-size: clamp(0.68rem, 1.8vw, 0.76rem);
        color: var(--am-muted);
        text-decoration: line-through;
    }

    .am-prod-disc {
        font-size: 0.67rem;
        font-weight: 600;
        background: #fde8e8;
        color: var(--am-red);
        padding: 2px 5px;
        border-radius: 4px;
        white-space: nowrap;
    }

    /* ── PRODUCT FOOTER / CTA ── */
    .am-prod-footer {
        padding: 0.55rem 0.6rem 0.65rem;
        display: flex;
        gap: 7px;
        border-top: 1px solid var(--am-border);
    }

        .am-prod-footer .btn {
            flex: 1;
            font-size: clamp(0.7rem, 2vw, 0.8rem);
            padding: 0.5rem 0.3rem;
            /* Proper 44px touch target */
            min-height: 44px;
        }

    @@media (max-width: 360px) {
        .am-prod-footer {
            flex-direction: column;
            gap: 5px;
        }

            .am-prod-footer .btn {
                width: 100%;
            }
    }

    /* ── EMPTY STATE ── */
    .am-empty {
        text-align: center;
        padding: clamp(2rem, 8vw, 4rem) 1rem;
        background: var(--am-surface);
        border-radius: var(--am-radius-lg);
        border: 1px solid var(--am-border);
    }

    .am-empty-icon {
        font-size: clamp(2.5rem, 8vw, 3.5rem);
        margin-bottom: 1rem;
    }

    .am-empty h3 {
        font-size: clamp(1rem, 3.5vw, 1.15rem);
        color: var(--am-ink);
        margin-bottom: 0.5rem;
    }

    .am-empty p {
        color: var(--am-muted);
        font-size: clamp(0.82rem, 2.5vw, 0.9rem);
    }

    /* ── PAGINATION ── */
    .am-pagination {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .am-page-btn {
        min-width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--am-border);
        border-radius: var(--am-radius);
        font-size: 0.85rem;
        color: var(--am-ink);
        text-decoration: none;
        background: var(--am-surface);
        transition: all 0.15s;
    }

        .am-page-btn:hover,
        .am-page-btn:focus-visible {
            border-color: var(--am-ink);
            color: var(--am-ink);
            outline: 2px solid var(--am-accent);
            outline-offset: 2px;
        }

        .am-page-btn.active {
            background: var(--am-ink);
            border-color: var(--am-ink);
            color: #fff;
            font-weight: 600;
        }

    @@media (max-width: 400px) {
        .am-page-btn {
            min-width: 38px;
            height: 38px;
            font-size: 0.8rem;
        }
    }

    /* ── TOAST NOTIFICATIONS ── */
    #cart-toast-container {
        position: fixed;
        bottom: max(1.5rem, env(safe-area-inset-bottom));
        right: 1.5rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        /* Cap width so toasts don't stretch full-screen on tablets */
        max-width: 320px;
    }

    @@media (max-width: 575px) {
        #cart-toast-container {
            left: 0.75rem;
            right: 0.75rem;
            bottom: max(1rem, env(safe-area-inset-bottom));
            max-width: none;
        }

            #cart-toast-container .alert {
                width: 100%;
                min-width: unset !important;
            }
    }

    /* ── FOCUS RING ── */
    :focus-visible {
        outline: 2px solid var(--am-accent);
        outline-offset: 2px;
    }
</style>

<div class="am-shop-layout">

    <!-- ── SIDEBAR ── -->
    <aside class="am-sidebar" aria-label="Product categories">
        <p class="am-sidebar-heading">Categories</p>
        <ul class="am-cat-list" role="list">
            <li class="@(Model.CategoryId == null ? "active" : "")">
                <a asp-controller="Shop" asp-action="Index"
                   asp-route-searchQuery="@Model.SearchQuery"
                   asp-route-sortBy="@Model.SortBy"
                   aria-current="@(Model.CategoryId == null ? "page" : null)">
                    All Products
                    <span class="am-cat-pill">@Model.TotalItems</span>
                </a>
            </li>
            @foreach (var cat in Model.Categories)
            {
                <li class="@(Model.CategoryId == cat.Id ? "active" : "")">
                    <a asp-controller="Shop" asp-action="Index"
                       asp-route-categoryId="@cat.Id"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-sortBy="@Model.SortBy"
                       aria-current="@(Model.CategoryId == cat.Id ? "page" : null)">
                        @cat.Name
                        <span class="am-cat-pill">@cat.Products.Count</span>
                    </a>
                </li>
            }
        </ul>
    </aside>

    <!-- ── MAIN CONTENT ── -->
    <div style="min-width:0;">

        <!-- Search & Sort -->
        <form method="get" class="am-search-bar" role="search" aria-label="Search and sort products">
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
            <input type="text"
                   name="searchQuery"
                   value="@Model.SearchQuery"
                   class="form-control am-search-input"
                   placeholder="Search products…"
                   aria-label="Search products"
                   autocomplete="off"
                   enterkeyhint="search" />
            <button type="submit" class="am-search-btn" aria-label="Search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="d-none d-sm-inline">Search</span>
            </button>
            <select name="sortBy"
                    id="am-sort-select"
                    class="form-select am-sort-select"
                    aria-label="Sort products">
                <option value="">Sort by</option>
                <option value="price_asc">Price: Low → High</option>
                <option value="price_desc">Price: High → Low</option>
                <option value="rating">Best Rating</option>
                <option value="newest">Newest First</option>
            </select>
        </form>

        <!-- Results meta -->
        <div class="am-results-meta" aria-live="polite" aria-atomic="true">
            <p class="am-results-count mb-0">
                <strong>@Model.TotalItems</strong> product@(Model.TotalItems != 1 ? "s" : "") found
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <span> for "<em>@Model.SearchQuery</em>"</span>
                }
            </p>
            @if (Model.TotalPages > 1)
            {
                <span class="am-results-count">Page @Model.PageNumber of @Model.TotalPages</span>
            }
        </div>

        <!-- Product Grid -->
        @if (Model.Products.Any())
        {
            <div class="am-prod-grid" role="list" aria-label="Products">
                @foreach (var p in Model.Products)
                {
                    <article class="am-prod-card" role="listitem" itemscope itemtype="https://schema.org/Product">

                        @if (p.OriginalPrice.HasValue)
                        {
                            <span class="am-prod-badge-sale" aria-label="On sale">SALE</span>
                        }
                        @if (p.Category != null)
                        {
                            <span class="am-prod-badge-cat" aria-hidden="true">@p.Category.Name</span>
                        }

                        <div class="am-prod-img">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl"
                                     alt="@p.Name"
                                     loading="lazy"
                                     decoding="async"
                                     itemprop="image" />
                            }
                            else
                            {
                                <span class="am-prod-img-placeholder" aria-hidden="true">📦</span>
                            }
                        </div>

                        <div class="am-prod-body">
                            @if (!string.IsNullOrEmpty(p.Brand))
                            {
                                <p class="am-prod-brand" itemprop="brand">@p.Brand</p>
                            }
                            <h2 class="am-prod-name" itemprop="name">@p.Name</h2>

                            <div class="am-rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
                                <meta itemprop="ratingValue" content="@p.Rating" />
                                <meta itemprop="reviewCount" content="@p.ReviewCount" />
                                <span class="am-stars" aria-label="@p.Rating out of 5 stars">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        @(s <= (int)Math.Round((double)p.Rating) ? "★" : "☆")
                                    }
                                </span>
                                <span class="am-rating-count" aria-label="@p.ReviewCount reviews">(@p.ReviewCount)</span>
                            </div>

                            <div class="am-prod-prices" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                <meta itemprop="priceCurrency" content="USD" />
                                <meta itemprop="price" content="@p.Price" />
                                <meta itemprop="availability" content="@(p.StockQuantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")" />
                                <span class="am-prod-price">$@p.Price</span>
                                @if (p.OriginalPrice.HasValue)
                                {
                                    <span class="am-prod-orig" aria-label="Original price $@p.OriginalPrice">$@p.OriginalPrice</span>
                                    <span class="am-prod-disc" aria-label="@p.DiscountPercentage percent off">-@p.DiscountPercentage%</span>
                                }
                            </div>
                        </div>

                        <div class="am-prod-footer">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.Id"
                               class="btn btn-outline-dark btn-sm"
                               aria-label="View @p.Name details">
                                View
                            </a>

                            @if (p.StockQuantity > 0)
                            {
                                <button class="btn btn-dark btn-sm btn-add-cart"
                                        data-product-id="@p.Id"
                                        aria-label="Add @p.Name to cart">
                                    Add
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled aria-label="@p.Name is out of stock">
                                    Out of Stock
                                </button>
                            }
                        </div>

                    </article>
                }
            </div>
        }
        else
        {
            <div class="am-empty" role="status">
                <div class="am-empty-icon" aria-hidden="true">🔍</div>
                <h3>No products found</h3>
                <p>Try adjusting your search or browse all categories.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-dark mt-3">
                    Clear filters
                </a>
            </div>
        }

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="am-pagination" aria-label="Product pages">
                @if (Model.PageNumber > 1)
                {
                    <a class="am-page-btn"
                       asp-controller="Shop" asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-sortBy="@Model.SortBy"
                       aria-label="Previous page">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var isCurrent = i == Model.PageNumber;
                    <a class="am-page-btn @(isCurrent ? "active" : "")"
                       asp-controller="Shop" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-sortBy="@Model.SortBy"
                       aria-label="Page @i"
                       aria-current="@(isCurrent ? "page" : null)">
                        @i
                    </a>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a class="am-page-btn"
                       asp-controller="Shop" asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-sortBy="@Model.SortBy"
                       aria-label="Next page">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                }
            </nav>
        }

    </div>
</div>

<!-- Toast container -->
<div id="cart-toast-container" aria-live="polite" aria-relevant="additions"></div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            /* ── RESTORE SORT SELECT VALUE ──
               Moved here (inside DOMContentLoaded) so the element
               is guaranteed to exist before we read/write it.       */
            function restoreSortSelect() {
                var sel = document.getElementById('am-sort-select');
                if (sel) {
                    sel.value = '@Model.SortBy';
                    sel.addEventListener('change', function () {
                        this.closest('form').submit();
                    });
                }
            }

            /* ── ADD TO CART ── */
            function attachAddToCart() {
                document.querySelectorAll('.btn-add-cart').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = true;

                    btn.addEventListener('click', async function () {
                        const productId = this.dataset.productId;
                        this.disabled = true;
                        const original = this.textContent.trim();
                        this.textContent = '…';

                        try {
                            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                            const headers = { 'Content-Type': 'application/x-www-form-urlencoded' };
                            if (token) headers['RequestVerificationToken'] = token;

                            const res = await fetch('/Cart/Add', {
                                method: 'POST',
                                headers,
                                body: `productId=${encodeURIComponent(productId)}&quantity=1`
                            });

                            const data = await res.json();

                            if (data.success) {
                                if (window.setCartBadge) window.setCartBadge(data.count || 0);
                                showToast('Added to cart!', 'success');
                                this.textContent = '✓ Added';
                                setTimeout(() => {
                                    this.textContent = original;
                                    this.disabled = false;
                                }, 1600);
                            } else {
                                showToast(data.message ?? 'Could not add item.', 'danger');
                                this.textContent = original;
                                this.disabled = false;
                            }
                        } catch {
                            showToast('Something went wrong.', 'danger');
                            this.textContent = original;
                            this.disabled = false;
                        }
                    });
                });
            }

            /* ── TOAST ── */
            function showToast(message, type) {
                const container = document.getElementById('cart-toast-container');
                if (!container) return;

                const toast = document.createElement('div');
                toast.className = `alert alert-${type} shadow-sm py-2 px-3 mb-0 d-flex align-items-center gap-2`;
                toast.style.cssText = 'min-width:220px;font-size:0.88rem;border-radius:10px;';

                const icon = type === 'success'
                    ? '<i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i>'
                    : '<i class="bi bi-exclamation-circle-fill flex-shrink-0" aria-hidden="true"></i>';

                toast.innerHTML = `${icon} <span>${message}</span>`;
                container.appendChild(toast);

                setTimeout(function () {
                    toast.style.transition = 'opacity 0.3s';
                    toast.style.opacity = '0';
                    setTimeout(() => toast.remove(), 300);
                }, 2800);
            }

            /* ── INIT ── */
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () {
                    restoreSortSelect();
                    attachAddToCart();
                });
            } else {
                restoreSortSelect();
                attachAddToCart();
            }
        })();
    </script>
}
