<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ═══════════════ SEO META TAGS ═══════════════ -->
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " – Afaq Mart" : "Afaq Mart | Online Shopping Pakistan")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Shop electronics, fashion, home goods and more at Afaq Mart. Best prices, fast delivery across Pakistan. Secure checkout guaranteed.")" />
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "online shopping pakistan, electronics, fashion, afaq mart, buy online")" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Afaq Mart" />
    <link rel="canonical" href="https://afaqmart.com@(Context.Request.Path)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Afaq Mart" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? ViewData["Title"] + " – Afaq Mart" : "Afaq Mart | Online Shopping Pakistan")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Shop thousands of products at unbeatable prices. Fast delivery across Pakistan.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "https://afaqmart.com/images/og-cover.jpg")" />
    <meta property="og:url" content="https://afaqmart.com@(Context.Request.Path)" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? ViewData["Title"] + " – Afaq Mart" : "Afaq Mart")" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Shop online at Afaq Mart – best prices, fast delivery.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "https://afaqmart.com/images/og-cover.jpg")" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/favicon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ═══════════════ GLOBAL DESIGN SYSTEM ═══════════════ -->
    <style>
        /* ── SKIP LINK ── */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: #0f172a;
            color: #fff;
            padding: 8px 16px;
            z-index: 10000;
            text-decoration: none;
            font-weight: 600;
            border-radius: 0 0 8px 0;
            transition: top .2s;
        }

            .skip-link:focus {
                top: 0;
            }

        /* ── Design Tokens ── */
        :root {
            --am-ink: #1a1a1a;
            --am-ink-soft: #2d2d2d;
            --am-page: #f5f4f1;
            --am-surface: #ffffff;
            --am-border: #e4e1d8;
            --am-muted: #6b7280;
            --am-accent: #b8820a;
            --am-accent-bg: #fef6e4;
            --am-green: #1a6e40;
            --am-red: #c0392b;
            --am-radius: 10px;
            --am-radius-lg: 16px;
            --am-shadow: 0 2px 16px rgba(0,0,0,.07);
            --am-shadow-lg: 0 8px 32px rgba(0,0,0,.11);
            --font-display: 'Playfair Display', Georgia, serif;
            --font-body: 'DM Sans', system-ui, sans-serif;
            --space-xs: clamp(0.25rem, 1vw, 0.5rem);
            --space-sm: clamp(0.5rem, 2vw, 0.75rem);
            --space-md: clamp(0.75rem, 3vw, 1rem);
            --space-lg: clamp(1rem, 4vw, 1.5rem);
            --space-xl: clamp(1.5rem, 5vw, 2rem);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            overflow-x: hidden;
            max-width: 100%;
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
        }

        body {
            font-family: var(--font-body);
            background: var(--am-page);
            color: var(--am-ink);
            font-size: clamp(14px, 2.5vw, 15px);
            line-height: 1.65;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        main {
            flex: 1;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-body);
            font-weight: 600;
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .btn {
            border-radius: var(--am-radius);
            font-family: var(--font-body);
            font-weight: 500;
            transition: all .18s ease;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-sm {
            min-height: 36px;
            font-size: clamp(0.75rem, 2vw, 0.85rem);
        }

        .btn-dark {
            background: var(--am-ink);
            border-color: var(--am-ink);
        }

            .btn-dark:hover {
                background: var(--am-ink-soft);
                border-color: var(--am-ink-soft);
                opacity: .9;
            }

        .btn-outline-dark {
            border-color: var(--am-border);
            color: var(--am-ink);
        }

            .btn-outline-dark:hover {
                background: var(--am-ink);
                border-color: var(--am-ink);
                color: #fff;
            }

        .alert {
            font-size: clamp(.82rem, 2.5vw, .95rem);
            border-radius: var(--am-radius);
            border: none;
        }

        .container {
            width: 100%;
            padding-left: clamp(0.75rem, 4vw, 1.5rem);
            padding-right: clamp(0.75rem, 4vw, 1.5rem);
        }

        @@media (max-width: 575px) {
            main.container {
                margin-top: 0.75rem !important;
                margin-bottom: 0.75rem !important;
            }
        }

        .card {
            border: 1px solid var(--am-border);
            border-radius: var(--am-radius-lg);
            background: var(--am-surface);
            box-shadow: none;
            transition: box-shadow .22s ease, transform .22s ease;
        }

            .card:hover {
                box-shadow: var(--am-shadow-lg);
                transform: translateY(-2px);
            }

        @@media (hover: none) {
            .card:hover {
                box-shadow: none;
                transform: none;
            }
        }

        .card-footer {
            background: var(--am-surface);
            border-top: 1px solid var(--am-border);
        }

        .badge {
            font-family: var(--font-body);
            font-weight: 500;
        }

        #cart-count-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background: #dc2626;
            color: #fff;
            font-size: .65rem;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            line-height: 1;
        }

        @@media (max-width: 575px) {
            .alert {
                border-radius: var(--am-radius);
                font-size: 0.85rem;
            }

                .alert .btn-close {
                    padding: 0.5rem;
                }
        }

        img {
            max-width: 100%;
            height: auto;
        }

        @@supports (padding: env(safe-area-inset-bottom)) {
            body {
                padding-left: env(safe-area-inset-left);
                padding-right: env(safe-area-inset-right);
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)

    @if (ViewContext.RouteData.Values["action"]?.ToString() != "Index" ||
        ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
    {
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "Organization",
              "@@id": "https://afaqmart.com/#organization",
              "name": "Afaq Mart",
              "url": "https://afaqmart.com",
              "logo": "https://afaqmart.com/images/logo.png",
              "description": "Online shopping store in Pakistan — electronics, fashion, home goods and more.",
              "address": { "@@type": "PostalAddress", "addressCountry": "PK" },
              "sameAs": [
                "https://www.facebook.com/afaqmart",
                "https://www.instagram.com/afaqmart"
              ]
            }
        </script>
    }
</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    @await Html.PartialAsync("_Navbar")

    <div class="container mt-3" aria-live="polite">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0" aria-hidden="true"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-circle-fill flex-shrink-0" aria-hidden="true"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <main id="main-content" class="container my-4">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        window.setCartBadge = function (count) {
            const badge = document.getElementById('cart-count-badge');
            if (!badge) return;
            badge.textContent = count > 99 ? '99+' : count;
            badge.style.display = count > 0 ? 'flex' : 'none';
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
