@model List<ECommerceApp.Areas.Admin.Models.ViewModels.CategoryViewModel>
@{
    
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">All Categories</h5>
    <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Category
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Products</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@c.ImageUrl" width="44" height="44"
                                     style="object-fit:cover;" class="rounded border" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                            }
                        </td>
                        <td class="fw-semibold">@c.Name</td>
                        <td class="text-muted">@c.Description</td>
                        <td><span class="badge bg-secondary">@c.ProductCount</span></td>
                        <td>
                            <a asp-area="Admin" asp-controller="Category" asp-action="Edit"
                               asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form asp-area="Admin" asp-controller="Category" asp-action="Delete"
                                  asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete &quot;@c.Name&quot;? Products in this category will be affected.')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No categories found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
