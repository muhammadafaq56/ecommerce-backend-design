@model ECommerceApp.Areas.Admin.Models.ViewModels.DashboardViewModel
@{
    
    ViewData["Title"] = "Dashboard";
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 text-bg-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Products</div>
                    <div class="fs-3 fw-bold">@Model.TotalProducts</div>
                </div>
                <i class="bi bi-box-seam fs-1 opacity-25"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                   class="text-white small opacity-75">View all →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 text-bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Revenue (Paid)</div>
                    <div class="fs-3 fw-bold">$@Model.TotalRevenue.ToString("N2")</div>
                </div>
                <i class="bi bi-currency-dollar fs-1 opacity-25"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                   class="text-white small opacity-75">View orders →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 text-bg-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Pending Orders</div>
                    <div class="fs-3 fw-bold">@Model.PendingOrders</div>
                </div>
                <i class="bi bi-clock fs-1 opacity-25"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Pending"
                   class="text-dark small opacity-75">View pending →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 text-bg-info">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Total Users</div>
                    <div class="fs-3 fw-bold">@Model.TotalUsers</div>
                </div>
                <i class="bi bi-people fs-1 opacity-25"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="User" asp-action="Index"
                   class="text-white small opacity-75">View all →</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold border-bottom">Recent Orders</div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.RecentOrders)
                {
                    <tr>
                        <td class="fw-semibold">@o.OrderNumber</td>
                        <td>
                            <div>@o.CustomerName</div>
                            <div class="text-muted small">@o.CustomerEmail</div>
                        </td>
                        <td>$@o.Total.ToString("N2")</td>
                        <td>
                            <span class="badge @GetStatusBadge(o.OrderStatus)">@o.OrderStatus</span>
                        </td>
                        <td class="text-muted small">@o.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Order" asp-action="Detail"
                               asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.RecentOrders.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No orders yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
