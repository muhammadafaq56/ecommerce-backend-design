@model ECommerceApp.Areas.Admin.Models.ViewModels.ProductViewModel
@{
   
    ViewData["Title"] = "Edit Product";
}

<div class="card border-0 shadow-sm" style="max-width:650px;">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Product" asp-action="Edit"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-semibold">Price ($)</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="OriginalPrice" class="form-label fw-semibold">
                        Original Price ($) <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <input asp-for="OriginalPrice" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="StockQuantity" class="form-label fw-semibold">Stock Quantity</label>
                    <input asp-for="StockQuantity" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Brand" class="form-label fw-semibold"></label>
                    <input asp-for="Brand" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.CategoryId))">
                        <option value="">— Select Category —</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" width="80" height="80"
                                 style="object-fit:cover;" class="rounded border" />
                            <span class="text-muted small ms-2">Current image</span>
                        </div>
                    }
                    <label asp-for="ImageFile" class="form-label fw-semibold">
                        @(string.IsNullOrEmpty(Model.ImageUrl) ? "Product Image" : "Replace Image")
                    </label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                </div>

                <div class="col-md-6">
                    <div class="form-check mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active (visible in shop)</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check mt-2">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label">Featured on homepage</label>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
}
