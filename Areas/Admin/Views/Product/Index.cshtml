@model List<ECommerceApp.Models.Product>
@{
    
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewData["Search"]"
               class="form-control form-control-sm" placeholder="Search name or brand..." style="width:220px;" />
        <button class="btn btn-sm btn-outline-secondary">Search</button>
        @if (ViewData["Search"] != null)
        {
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-link">Clear</a>
        }
    </form>
    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Product
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Featured</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" width="44" height="44"
                                     style="object-fit:cover;" class="rounded border" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@p.Name</div>
                            @if (p.OriginalPrice.HasValue)
                            {
                                <div class="small text-muted">
                                    <s>$@p.OriginalPrice.Value.ToString("N2")</s>
                                    <span class="text-danger ms-1">-@p.DiscountPercentage%</span>
                                </div>
                            }
                        </td>
                        <td class="text-muted">@p.Brand</td>
                        <td>@p.Category?.Name</td>
                        <td class="fw-semibold">$@p.Price.ToString("N2")</td>
                        <td>
                            <span class="@(p.StockQuantity < 10 ? "text-danger fw-semibold" : "")">
                                @p.StockQuantity
                            </span>
                        </td>
                        <td>
                            @if (p.IsFeatured)
                            {
                                <i class="bi bi-star-fill text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted"></i>
                            }
                        </td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a asp-area="Admin" asp-controller="Product" asp-action="Edit"
                               asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form asp-area="Admin" asp-controller="Product" asp-action="Delete"
                                  asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete &quot;@p.Name&quot;?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
